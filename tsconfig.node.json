{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "server/**/*.ts", "src/core/resources/resource_types.ts", "src/providers/errors.ts", "src/types/k8s.ts", "shared/*.json"]
}
