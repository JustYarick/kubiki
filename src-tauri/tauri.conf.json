{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kubiki",
  "version": "0.1.0",
  "identifier": "com.kubiki.app",
  "build": {
    "beforeDevCommand": "pnpm desktop:prepare && pnpm extensions:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm desktop:prepare && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kubiki - Kubernetes IDE",
        "backgroundColor": "#1e1f22",
        "transparent": false,
        "zoomHotkeysEnabled": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.kubiki-build/extension-host.cjs": "extensions-runtime/extension-host.cjs",
      "../.kubiki-build/extensions/": "extensions-runtime/extensions/",
      "../.kubiki-build/runtime/": "extensions-runtime/runtime/"
    }
  }
}
